{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenCode (opencode 目錄)",
      "type": "process",
      "command": "C:\\Users\\User\\AppData\\Local\\Programs\\opencode\\opencode.exe",
      "options": {
        "cwd": "${workspaceFolder}\\opencode"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "group": "multi-agent"
      },
      "problemMatcher": []
    },
    {
      "label": "Antigravity CLI (antigravity 目錄)",
      "type": "process",
      "command": "C:\\Users\\User\\AppData\\Local\\agy\\bin\\agy.exe",
      "options": {
        "cwd": "${workspaceFolder}\\antigravity"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "group": "multi-agent"
      },
      "problemMatcher": []
    },
    {
      "label": "雙代理一對一獨立啟動（OpenCode + Antigravity）",
      "dependsOn": [
        "OpenCode (opencode 目錄)",
        "Antigravity CLI (antigravity 目錄)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
